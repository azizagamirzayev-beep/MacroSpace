name: Build APK
on: [push, workflow_dispatch]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # 1. Remove old unzipped folder completely so old files/signatures don't stick around
      - run: rm -rf MacroSpace

      # 2. Extract the new zip file
      - run: unzip -o MacroSpace.zip

      # 3. Setup Java 17
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      # 4. Setup Gradle 8.7
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"

      # 5. Force a completely CLEAN build (no cached broken builds)
      - run: gradle clean assembleDebug assembleRelease --no-daemon
        working-directory: MacroSpace

      # 6. Upload both Debug and Release APKs
      - uses: actions/upload-artifact@v4
        with:
          name: MacroSpace-APKs
          path: MacroSpace/app/build/outputs/apk/**/*.apk
 
